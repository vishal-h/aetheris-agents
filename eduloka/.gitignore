# Provider-native raw records — never commit client/API data
data/raw/
data/edux/
data/gold/
data/export/

# Generated output (keep sentinel)
output/*
!output/.gitkeep

# data/terms.txt is committed config — intentionally NOT excluded

# Per-step run/artifact record (ds t2) — names artifacts and their hashes, so it
# describes real output; gitignored on the same ground as the artifacts
data/run-records.json
data/run-records.json.lock
